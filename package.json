{
  "name": "@smd00/device-fingerprint",
  "version": "0.1.1",
  "description": "Lightweight browser device fingerprint: canvas, WebGL, and navigator signals with optional server-side hashing",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smd00/device-fingerprint.git"
  },
  "bugs": {
    "url": "https://github.com/smd00/device-fingerprint/issues"
  },
  "homepage": "https://github.com/smd00/device-fingerprint#readme",
  "keywords": [
    "fingerprint",
    "device-fingerprint",
    "browser",
    "canvas",
    "webgl",
    "fraud"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
